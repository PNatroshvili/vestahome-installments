# ==== ზოგადი ====
PORT=3000
# ეს backend-ის საჯარო მისამართია, სადაც deploy-ის შემდეგ აღმოჩნდება (მაგ. Render/Railway-ს URL)
APP_BASE_URL=https://your-backend-domain.example.com

# ==== Shopify ====
# Settings -> Domains-ში ნახავთ თქვენს *.myshopify.com მისამართს
SHOPIFY_STORE_DOMAIN=vestahome.myshopify.com
# Custom App-ის Admin API access token — თავიდან ცარიელი; /auth/shopify/install-ის
# გავლის შემდეგ (იხ. docs/SETUP-ka.md, ნაბიჯი 1) გამოჩენილი token აქ ჩაწერეთ.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# Dev Dashboard-ის აპის Settings გვერდიდან (Client ID / Client Secret) —
# საჭიროა მხოლოდ ერთხელ, /auth/shopify/install-ის გასავლელად. token-ის მიღების
# შემდეგ შეგიძლიათ აქაც დატოვოთ (არაფერს აფუჭებს) ან წაშალოთ.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ==== Bank of Georgia (api.bog.ge) ====
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# ეს URL BOG-ის მერჩანტ-კაბინეტში/მენეჯერთან უნდა მიუთითოთ callback მისამართად
BOG_CALLBACK_URL=https://your-backend-domain.example.com/webhooks/bog

# ==== Credo Bank (ganvadeba.credo.ge) ====
CREDO_MERCHANT_ID=
CREDO_PASSWORD=

# დაცული endpoint-ის (Credo სტატუსების პერიოდული შემოწმება) გასაღები —
# შეარჩიეთ გრძელი შემთხვევითი სტრიქონი და გამოიყენეთ გარე cron სერვისში (იხ. SETUP-ka.md)
POLL_SECRET=change-me-to-a-long-random-string
